# ==========================================
# TIDE PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and update with your values

# ------------------------------------------
# Application
# ------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgresql://tide:tide_password@localhost:5432/tide
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ------------------------------------------
# Redis
# ------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3

# ------------------------------------------
# Kafka
# ------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tide-platform
KAFKA_GROUP_ID=tide-consumers

# ------------------------------------------
# Authentication & JWT
# ------------------------------------------
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-characters-long-please-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-please-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ------------------------------------------
# OAuth - Gmail
# ------------------------------------------
# GMAIL_CLIENT_ID=your-gmail-client-id
# GMAIL_CLIENT_SECRET=your-gmail-client-secret
# GMAIL_REDIRECT_URI=http://localhost:4000/auth/gmail/callback

# ------------------------------------------
# OAuth - Microsoft Exchange
# ------------------------------------------
# EXCHANGE_CLIENT_ID=your-exchange-client-id
# EXCHANGE_CLIENT_SECRET=your-exchange-client-secret
# EXCHANGE_TENANT_ID=your-tenant-id
# EXCHANGE_REDIRECT_URI=http://localhost:4000/auth/exchange/callback

# ------------------------------------------
# OAuth - Google Calendar
# ------------------------------------------
# GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
# GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/auth/calendar/callback
GOOGLE_CLIENT_ID=526055709746-23s75tpvvmf45136fuh2sk5gaakk7mde.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=https://aiassistant-production-5333.up.railway.app/auth/callback

# iOS client ID (for mobile app configuration)
GOOGLE_IOS_CLIENT_ID=526055709746-golq3n9mgv1oh55sgim0s5qrqcped8j6.apps.googleusercontent.com

# ------------------------------------------
# AI Services
# ------------------------------------------
# OpenAI
OPENAI_API_KEY=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
OPENAI_ORG_ID=org-33qgmn6Wg3h1QQPOceFVSMQB

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------
# Vector Database (Pinecone)
# ------------------------------------------
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=tide-embeddings

# ------------------------------------------
# Monitoring & Observability
# ------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn
# DATADOG_API_KEY=your-datadog-api-key

# ------------------------------------------
# Feature Flags
# ------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_EMAIL_SYNC=true
ENABLE_CALENDAR_SYNC=true
ENABLE_WORKFLOW_ENGINE=true

# ------------------------------------------
# CORS
# ------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ------------------------------------------
# Rate Limiting
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# WebSocket
# ------------------------------------------
WEBSOCKET_PORT=4003
WEBSOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ------------------------------------------
# Email (SMTP) - Optional
# ------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@tide.ai

# ------------------------------------------
# Service URLs (for microservices)
# ------------------------------------------
# AUTH_SERVICE_URL=http://localhost:4001
# EVENTS_SERVICE_URL=http://localhost:4002
# REALTIME_SERVICE_URL=http://localhost:4003
# GATEWAY_PORT=4000

# ------------------------------------------
# Development URLs
# ------------------------------------------
# Kafka UI: http://localhost:8080
# Prometheus: http://localhost:9090
# Grafana: http://localhost:3001 (admin/admin)
