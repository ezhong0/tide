# ------------------------------------------
# Kafka (Infrastructure Ready - Not Yet Used)
# ------------------------------------------
# Status: Infrastructure ready, event publishing planned for Week 4-5
# Planned topics: ai.requests, ai.responses, email.received, calendar.events

# Local development (Docker Compose optional)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tide-platform
KAFKA_GROUP_ID=tide-consumers

# Production (Railway-managed Kafka)
# KAFKA_URL=${KAFKA_URL}
# KAFKA_SASL_USERNAME=${KAFKA_SASL_USERNAME}
# KAFKA_SASL_PASSWORD=${KAFKA_SASL_PASSWORD}

# ------------------------------------------
# Feature Flags
# ------------------------------------------
