# ==========================================
# TIDE PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and update with your values

# ------------------------------------------
# Application
# ------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgresql://tide:tide_password@localhost:5432/tide
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ------------------------------------------
# Redis
# ------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3

# ------------------------------------------
# Kafka
# ------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tide-platform
KAFKA_GROUP_ID=tide-consumers

# ------------------------------------------
# Authentication & JWT
# ------------------------------------------
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-characters-long-please-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-please-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ------------------------------------------
# OAuth - Google (Gmail + Calendar)
# ------------------------------------------
# Single OAuth client for all Google services (Gmail, Calendar, Drive, etc.)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ------------------------------------------
# OAuth - Microsoft Exchange (Outlook + Calendar)
# ------------------------------------------
# EXCHANGE_CLIENT_ID=your-exchange-client-id
# EXCHANGE_CLIENT_SECRET=your-exchange-client-secret
# EXCHANGE_TENANT_ID=your-tenant-id
# EXCHANGE_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback

# ------------------------------------------
# AI Services
# ------------------------------------------
# Anthropic Claude (Primary - using Haiku 4.5)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: Override model (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (Backup/Alternative)
# OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...

# ------------------------------------------
# Vector Database (Pinecone)
# ------------------------------------------
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=tide-embeddings

# ------------------------------------------
# Monitoring & Observability
# ------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn
# DATADOG_API_KEY=your-datadog-api-key

# ------------------------------------------
# Feature Flags
# ------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_EMAIL_SYNC=true
ENABLE_CALENDAR_SYNC=true
ENABLE_WORKFLOW_ENGINE=true

# ------------------------------------------
# CORS
# ------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ------------------------------------------
# Rate Limiting
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# WebSocket
# ------------------------------------------
WEBSOCKET_PORT=4003
WEBSOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ------------------------------------------
# Email (SMTP) - Optional
# ------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@tide.ai

# ------------------------------------------
# Service URLs (for microservices)
# ------------------------------------------
# AUTH_SERVICE_URL=http://localhost:4001
# EVENTS_SERVICE_URL=http://localhost:4002
# REALTIME_SERVICE_URL=http://localhost:4003
# GATEWAY_PORT=4000

# ------------------------------------------
# Development URLs
# ------------------------------------------
# Kafka UI: http://localhost:8080
# Prometheus: http://localhost:9090
# Grafana: http://localhost:3001 (admin/admin)
