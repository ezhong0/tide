# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://tide:tide_dev_password@localhost:5432/tide_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# Message Queue (RabbitMQ)
RABBITMQ_URL=amqp://tide:tide_dev_password@localhost:5672
# Or use AWS SQS
# AWS_SQS_QUEUE_URL=
# AWS_REGION=us-east-1

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OAuth - Google (for Gmail and Calendar)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OAuth - Microsoft (for Outlook and Calendar)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORGANIZATION=your-org-id

# Deepgram Speech-to-Text
DEEPGRAM_API_KEY=your-deepgram-api-key

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=tide-emails

# AWS (for S3, SES, etc.)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tide-email-archives

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:8081
CORS_CREDENTIALS=true

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=5000

# Feature Flags
ENABLE_VOICE_COMMANDS=true
ENABLE_EMAIL_SENDING=true
ENABLE_CALENDAR_INTEGRATION=true
ENABLE_LEARNING_ENGINE=true
