# Application
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://tide:tide_dev_password@localhost:5432/tide

# Redis
REDIS_URL=redis://:tide_redis_password@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=tide-dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# API Gateway
GATEWAY_PORT=4000
GATEWAY_CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Services
AUTH_SERVICE_URL=http://localhost:4001
EVENTS_SERVICE_URL=http://localhost:4002
REALTIME_SERVICE_URL=http://localhost:4003

# AI Configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email Providers
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret

# Calendar Providers
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret

# Monitoring
SENTRY_DSN=your-sentry-dsn-optional
