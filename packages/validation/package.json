{
  "name": "@tide/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod validation schemas for Tide",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@tide/shared-types": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
