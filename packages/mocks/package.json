{
  "name": "@tide/mocks",
  "version": "1.0.0",
  "private": true,
  "description": "Realistic mock implementations for all Tide services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:performance": "jest --testPathPattern=performance",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@tide/contracts": "workspace:*",
    "@tide/types": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}