# Database Configuration
DATABASE_URL=postgresql://tide:tide_password@localhost:5432/tide

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka Configuration (placeholder - not required for Alpha integration)
KAFKA_BROKERS=localhost:9092

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production-min-32-chars

# Service Ports
AUTH_SERVICE_PORT=4001
REALTIME_SERVICE_PORT=4002

# Node Environment
NODE_ENV=development
