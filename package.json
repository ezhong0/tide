{
  "name": "tide",
  "version": "1.0.0",
  "private": true,
  "description": "AI Executive Assistant with ultra-low latency and sophisticated reasoning",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --recursive test",
    "test:watch": "pnpm --recursive test -- --watch",
    "test:coverage": "pnpm --recursive test -- --coverage",
    "test:contracts": "pnpm --filter @tide/contracts test",
    "test:performance": "pnpm --filter @tide/mocks test:performance",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "clean": "pnpm --recursive clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^8.0.3",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}