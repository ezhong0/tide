# =====================================================
# Supabase Configuration
# =====================================================
# Get these values from: https://app.supabase.com/project/_/settings/api
# Replace with your actual Supabase project values

# Project URL (e.g., https://xyzproject.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Anon/Public key (safe for client-side use)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (NEVER expose to clients - backend only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (for local development)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# =====================================================
# OAuth Provider Configuration
# =====================================================
# Google OAuth (for Gmail + Google Calendar)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (for Outlook + Outlook Calendar)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# =====================================================
# Backend Service Configuration
# =====================================================
# Keep these for AI/Email/Calendar services

# AI Service
AI_SERVICE_URL=http://localhost:4003
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email Service
EMAIL_SERVICE_URL=http://localhost:4004

# Calendar Service
CALENDAR_SERVICE_URL=http://localhost:4005

# =====================================================
# Optional: Local Supabase Development
# =====================================================
# Only needed if running Supabase locally (not recommended for Alpha)
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
